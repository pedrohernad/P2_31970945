<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/styles.css">
  <title>Autenticación</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/auth.css">
  <script src="js/alertConfig.js"></script>
  <style>
    :root{
      --primary:#0066cc;
      --secondary:#00ccff;
      --accent:#ff6600;
      --dark:#1a1a2e;
      --light:#f8f9fa;
    }
  </style>
</head>
<body>
  <nav class="w-full bg-[var(--dark)] text-[var(--light)] fixed top-0 z-50 shadow-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-16">

    <!-- Logo -->
    <a href="#Inicio" class="flex items-center gap-2">
      <img src="/img/CONTA-removebg-preview.png" alt="Logo" class="h-8 w-auto">
      <span class="font-semibold text-lg">Conta App</span>
    </a>

    <!-- Mobile menu button -->
    <button id="nav-toggle" class="md:hidden text-2xl focus:outline-none">
      <i class="fas fa-bars"></i>
    </button>

    <!-- Desktop Menu -->
    <ul id="nav-menu" class="hidden md:flex md:items-center md:space-x-6 font-medium">
      <li><a href="/" class="hover:text-[var(--secondary)] transition-colors"><%= __('nav.inicio') %></a></li>
      <li><a href="#Usuarios" class="hover:text-[var(--secondary)] transition-colors"><%= __('nav.usuarios') %></a></li>
      <li><a href="#Empresa" class="hover:text-[var(--secondary)] transition-colors"><%= __('nav.empresa') %></a></li>
      <li><a href="/getPayment" class="hover:text-[var(--secondary)] transition-colors"><%= __('nav.pagos') %></a></li>
      <li><a href="/admin/contacts" class="hover:text-[var(--secondary)] transition-colors"><%= __('nav.contactos') %></a></li>
      <li>
        <a href="/login?form=login" class="hover:text-[var(--accent)] flex items-center gap-1 transition-colors">
          <i class="fa fa-sign-in-alt"></i><%= __('nav.login') %>
        </a>
      </li>
      <% if (isAdmin) { %>
      <li>
        <a href="/logout" class="hover:text-[var(--accent)] flex items-center gap-1 transition-colors">
          <i class="fas fa-sign-out-alt"></i><%= __('nav.logout') %>
        </a>
      </li>
      <% } %>

      <!-- Language Dropdown -->
      <li class="relative group">
        <button class="flex items-center gap-1 hover:text-blue-400 transition duration-200">
          🌐 <span>Idioma</span>
          <i class="fas fa-chevron-down text-xs mt-[2px]"></i>
        </button>
        <ul class="absolute right-0 mt-2 bg-white text-black rounded-md shadow-lg overflow-hidden opacity-0 group-hover:opacity-100 scale-95 group-hover:scale-100 transition-all duration-200 transform origin-top min-w-[120px] z-50">
          <li>
            <a href="/login?form=<%= formType %>&lang=es" class="block px-4 py-2 hover:bg-blue-100 transition-colors">
              🇪🇸 Español
            </a>
          </li>
          <li>
            <a href="/login?form=<%= formType %>&lang=en" class="block px-4 py-2 hover:bg-blue-100 transition-colors">
              🇺🇸 English
            </a>
          </li>
        </ul>
      </li>
    </ul>
  </div>

  <!-- Mobile Dropdown Menu -->
  <ul id="nav-mobile" class="md:hidden hidden flex-col bg-[var(--dark)] text-[var(--light)] space-y-3 py-4 px-6">
    <li><a href="/" class="block"><%= __('nav.inicio') %></a></li>
    <li><a href="#Usuarios" class="block"><%= __('nav.usuarios') %></a></li>
    <li><a href="#Empresa" class="block"><%= __('nav.empresa') %></a></li>
    <li><a href="/getPayment" class="block"><%= __('nav.pagos') %></a></li>
    <li><a href="/admin/contacts" class="block"><%= __('nav.contactos') %></a></li>
    <li><a href="/login?form=login" class="block"><%= __('nav.login') %></a></li>
    <% if (isAdmin) { %>
    <li><a href="/logout" class="block"><%= __('nav.logout') %></a></li>
    <% } %>
    <!-- Language toggle mobile -->
    <li class="flex gap-3 items-center">
      <a href="/login?form=<%= formType %>&lang=es" class="hover:text-blue-400 transition-colors">🇪🇸 Español</a>
      <span class="text-gray-400">|</span>
      <a href="/login?form=<%= formType %>&lang=en" class="hover:text-blue-400 transition-colors">🇺🇸 English</a>
    </li>
  </ul>
</nav>
  <div class="flex items-center justify-center min-h-screen bg-[var(--light)] py-10 px-4">
    <div class="w-full max-w-lg bg-white rounded-xl shadow-lg p-8">

      <!-- Switcher -->
      <div class="flex justify-center mb-8">
        <button
        class="w-1/2 py-2 text-center font-semibold rounded-l-xl transition
        <%= formType==='login' ? 'bg-[var(--primary)] text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200' %>"
        onclick="switchForm('login')">
        <%= __('auth.loginTab') %>
      </button>
      <button
      class="w-1/2 py-2 text-center font-semibold rounded-r-xl transition
      <%= formType==='register' ? 'bg-[var(--primary)] text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200' %>"
      onclick="switchForm('register')">
      <%= __('auth.registerTab') %>
    </button>
  </div>

  <!-- LOGIN -->
  <% if (formType==='login'){ %>
  <form id="formLogin" class="space-y-5">
    <h2 class="text-2xl font-bold text-center text-[var(--dark)] mb-4"><%= __('auth.loginTab') %></h2>

    <div>
      <label for="login-email" class="block text-sm font-medium mb-1"><%= __('auth.email') %></label>
      <input id="login-email" name="email" type="email"
      placeholder="<%= __('auth.emailPlaceholder') %>"
      class="w-full border rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-[var(--secondary)]"
      required>
    </div>

    <div>
      <label for="login-password" class="block text-sm font-medium mb-1"><%= __('auth.password') %></label>
      <input id="login-password" name="password" type="password"
      placeholder="<%= __('auth.passwordPlaceholder') %>"
      class="w-full border rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-[var(--secondary)]"
      required>
    </div>

    <a href="/auth/google"
    class="flex items-center justify-center gap-2 bg-red-500 hover:bg-red-600 text-white py-2 rounded-lg transition">
    <i class="fab fa-google"></i><%= __('auth.google') %>
  </a>

  <button type="submit"
  class="w-full bg-[var(--primary)] hover:bg-blue-700 text-white font-semibold py-2 rounded-lg transition">
  <%= __('auth.loginButton') %>
</button>
</form>

<!-- REGISTER -->
<% } else { %>
<form id="formRegister" class="space-y-5">
  <h2 class="text-2xl font-bold text-center text-[var(--dark)] mb-4"><%= __('auth.createAccount') %></h2>

  <div>
    <label for="username" class="block text-sm font-medium mb-1"><%= __('auth.fullName') %></label>
    <input id="username" name="username" type="text"
    placeholder="<%= __('auth.namePlaceholder') %>"
    class="w-full border rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-[var(--secondary)]"
    required>
  </div>

  <div>
    <label for="register-email" class="block text-sm font-medium mb-1"><%= __('auth.email') %></label>
    <input id="register-email" name="email" type="email"
    placeholder="<%= __('auth.emailPlaceholder') %>"
    class="w-full border rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-[var(--secondary)]"
    required>
  </div>

  <div>
    <label for="register-password" class="block text-sm font-medium mb-1"><%= __('auth.password') %></label>
    <input id="register-password" name="password_hash" type="password"
    placeholder="<%= __('auth.passwordPlaceholder') %>"
    class="w-full border rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-[var(--secondary)]"
    minlength="6" required>
  </div>

  <div>
    <label for="register-confirm" class="block text-sm font-medium mb-1"><%= __('auth.confirmPassword') %></label>
    <input id="register-confirm" name="passwordHash" type="password"
    placeholder="<%= __('auth.passwordPlaceholder') %>"
    class="w-full border rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-[var(--secondary)]"
    required>
  </div>

  <button type="submit"
  class="w-full bg-[var(--primary)] hover:bg-blue-700 text-white font-semibold py-2 rounded-lg transition">
  <%= __('auth.registerButton') %>
</button>
</form>
<% } %>
</div>
</div>
<script>
  function switchForm(form){ window.location.search = '?form='+form; }
</script>
<script>
  let data,formData
  const formRegister = document.querySelector('#formRegister');
  if (formRegister) {
    formRegister.addEventListener('submit', e => {
      e.preventDefault();
      formData = new FormData(e.target);
      data = Object.fromEntries(formData.entries());
      fetch('/registerUser', {
        method: 'POST',
        headers: {
          "Content-type": "application/json"
        },
        body: JSON.stringify(data)
      })
      .then(res => res.json())
      .then(res => {
        Swal.fire(res.message);
      });
    });
  }
</script>

<script>
  const formLogin = document.querySelector('#formLogin');
  if (formLogin) {
    formLogin.addEventListener('submit', e => {
      e.preventDefault();
      formData = new FormData(e.target);
      data = Object.fromEntries(formData.entries());
      fetch('/loginPost', {
        method: 'POST',
        headers: {
          "Content-type": "application/json"
        },
        body: JSON.stringify(data)
      })
      .then(res => res.json())
      .then(res => {
        if (res.status) {
          Swal.fire(res.message).then(() => {
            window.location.href = '/admin/contacts';
          });
        } else {
          Swal.fire(res.message);
        }
      });
    });
  }
</script>
</body>
</html>