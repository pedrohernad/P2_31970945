        <div class="container">
            <h6 class="xs-font mb-0"><%= t('index.portfolio.subtitle') %></h6>
            <h3 class="section-title pb-4"><%= t('index.portfolio.title') %></h3>
        </div>

        <div id="owl-portfolio" class="owl-carousel owl-theme mt-4">
            <div class="item expertises-item">
                <img src="assets/imgs/img-1.jpg" alt="Diseño de logotipo" class="box-shadow">
                <h6 class="mt-3 mb-2"><%= t('index.portfolio.item1.title') %></h6>
                <p class="xs-font"><%= t('index.portfolio.item1.desc') %></p>
            </div> 
            <div class="item expertises-item">
                <img src="assets/imgs/img-2.jpg" alt="Packaging design" class="box-shadow">
                <h6 class="mt-3 mb-2"><%= t('index.portfolio.item2.title') %></h6>
                <p class="xs-font"><%= t('index.portfolio.item2.desc') %></p>
            </div>
            <div class="item expertises-item">
                <img src="assets/imgs/img-3.jpg" alt="Diseño editorial" class="box-shadow">
                <h6 class="mt-3 mb-2"><%= t('index.portfolio.item3.title') %></h6>
                <p class="xs-font"><%= t('index.portfolio.item3.desc') %></p>
            </div>
            <div class="item expertises-item">
                <img src="assets/imgs/img-4.jpg" alt="Diseño publicitario" class="box-shadow">
                <h6 class="mt-3 mb-2"><%= t('index.portfolio.item4.title') %></h6>
