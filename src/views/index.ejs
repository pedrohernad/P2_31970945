    <!-- Servicios -->
    <section class="section">  
        <div class="container">
            <h6 class="xs-font mb-0"><%= t('index.services.subtitle') %></h6>
            <h3 class="section-title mb-4"><%= t('index.services.title') %></h3>

            <div class="row text-center">
                <div class="col-lg-4">
                    <div class="card border-0 text-dark">
                        <img class="card-img-top" src="assets/imgs/img-5.jpg" alt="Diseño de marca">
                        <div class="card-body">
                            <h4 class="title mt-4"><%= t('index.services.item1.title') %></h4>
                            <p class="xs-font"><%= t('index.services.item1.desc') %></p>
                            <p class="h5 text-primary mt-3"><%= t('index.services.price1') %></p>
                            <a href="/payment"  class="btn btn-primary btn-rounded mt-3"><%= t('index.services.button') %></a> 
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="card border-0 text-dark">
                        <img class="card-img-top" src="assets/imgs/img-6.jpg" alt="Diseño editorial">
                        <div class="card-body">
                            <h4 class="title mt-4"><%= t('index.services.item2.title') %></h4>
                            <p class="xs-font"><%= t('index.services.item2.desc') %></p>
                            <p class="h5 text-primary mt-3"><%= t('index.services.price2') %></p>
                            <a href="/payment"  class="btn btn-primary btn-rounded mt-3"><%= t('index.services.button') %></a>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="card border-0 text-dark">
                        <img class="card-img-top" src="assets/imgs/img-7.jpg" alt="Diseño publicitario">
                        <div class="card-body">
                            <h4 class="title mt-4"><%= t('index.services.item3.title') %></h4>
                            <p class="xs-font"><%= t('index.services.item3.desc') %></p>
                            <p class="h5 text-primary mt-3"><%= t('index.services.price3') %></p> 
                            <a href="/payment"  class="btn btn-primary btn-rounded mt-3"><%= t('index.services.button') %></a> 
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- Portafolio Completo -->
