    <meta name="description" content="Servicios profesionales de diseño gráfico freelance">
    <meta name="author" content="Ollie Design">
    <title>Pedro - Diseño Gráfico Freelance</title>

    <!-- Iconos -->
    <link rel="stylesheet" href="assets/vendors/themify-icons/css/themify-icons.css">
    
    <!-- Owl Carousel -->
    <link rel="stylesheet" href="assets/vendors/owl-carousel/css/owl.carousel.css">
