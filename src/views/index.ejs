        <div class="container">
            <a class="navbar-brand" href="#"><img src="assets/imgs/brand.svg" alt="Logo Ollie Design" class="brand-img"></a>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav ml-auto">
                    <li class="nav-item"><a class="nav-link" href="#home"><%= t('index.nav.home') %></a></li>
                    <li class="nav-item"><a class="nav-link" href="#about"><%= t('index.nav.about') %></a></li>
                    <li class="nav-item"><a class="nav-link" href="#portfolio"><%= t('index.nav.portfolio') %></a></li>
                    <li class="nav-item"><a class="nav-link" href="#testmonial"><%= t('index.nav.clients') %></a></li>
                    <li class="nav-item"><a class="nav-link" href="#blog"><%= t('index.nav.blog') %></a></li>
                    <li class="nav-item"><a class="nav-link" href="/getPayment"><%= t('index.nav.payments') %></a></li>
                    <li class="nav-item ml-0 ml-lg-4">
                        <a class="nav-link btn btn-primary" href="/admin/contacts"><%= t('index.nav.contacts') %></a>
                    </li>
                </ul>
                <!-- Language Switcher -->
    <div class="flex gap-2 mt-2 md:mt-0">
      <a href="/?lang=es" class="inline-flex items-center px-3 py-1.5 rounded-md bg-white text-gray-700 border border-gray-300 shadow-sm hover:bg-blue-100 hover:text-blue-700 text-sm">
        🇪🇸 <span class="ml-1">Español</span>
      </a>
      <a href="/?lang=en" class="inline-flex items-center px-3 py-1.5 rounded-md bg-white text-gray-700 border border-gray-300 shadow-sm hover:bg-blue-100 hover:text-blue-700 text-sm">
        🇺🇸 <span class="ml-1">English</span>
      </a>
    </div>
            </div>
        </div>
    </nav>

    <!-- Cabecera -->
    <header id="home" class="header">
        <div class="overlay"></div>

        <div id="header-carousel" class="carousel slide carousel-fade" data-ride="carousel">  
            <div class="container">
                <div class="carousel-inner">
                    <div class="carousel-item active">
                        <div class="carousel-caption d-none d-md-block">
                            <h1 class="carousel-title"><%= t('index.header.title1') %></h1>
                            <button class="btn btn-primary btn-rounded"><%= t('index.header.button1') %></button>
                        </div>
                    </div>
                    <div class="carousel-item">
                        <div class="carousel-caption d-none d-md-block">
                            <h1 class="carousel-title"><%= t('index.header.title2') %></h1>
                            <button class="btn btn-primary btn-rounded"><%= t('index.header.button2') %></button>
                        </div>
                    </div>
                    <div class="carousel-item">
                        <div class="carousel-caption d-none d-md-block">
                            <h1 class="carousel-title"><%= t('index.header.title3') %></h1>
                            <button class="btn btn-primary btn-rounded"><%= t('index.header.button3') %></button>
                        </div>
                    </div>
                </div>
            </div>        
        </div>

        <div class="infos container mb-4 mb-md-2">
            <div class="title">
                <h6 class="subtitle font-weight-normal"><%= t('index.header.subtitle') %></h6>
                <h5><%= t('index.header.title') %></h5>
                <p class="font-small"><%= t('index.header.description') %></p>
            </div>
            <div class="socials text-right">
                <div class="row justify-content-between">
                    <div class="col">
                        <a class="d-block subtitle"><i class="ti-microphone pr-2"></i> <%= t('index.contact.phone') %></a>
                        <a class="d-block subtitle"><i class="ti-email pr-2"></i> <%= t('index.contact.email') %></a>
                    </div>
                    <div class="col">
                        <h6 class="subtitle font-weight-normal mb-2"><%= t('index.social.title') %></h6>
                        <div class="social-links">
                            <a  href="#" class="link pr-1"><i class="ti-behance"></i></a>
                            <a  href="#" class="link pr-1"><i class="ti-dribbble"></i></a>
                            <a  href="https://www.instagram.com/accounts/login/?source=logged_out_sem" class="link pr-1"><i class="ti-instagram"></i></a>
                            <a  href="https://www.facebook.com/?locale2=es_ES&_rdr" class="link pr-1"><i class="ti-facebook"></i></a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- Sección Sobre mí -->
