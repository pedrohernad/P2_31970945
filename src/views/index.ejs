    <!-- Testimonios Completos -->
    <section class="section" id="testmonial">
        <div class="container">
            <h6 class="xs-font mb-0"><%= t('index.testimonials.subtitle') %></h6>
            <h3 class="section-title"><%= t('index.testimonials.title') %></h3>

            <div id="owl-testmonial" class="owl-carousel owl-theme mt-4">
                <div class="item">
                    <div class="textmonial-item">
                        <img src="assets/imgs/avatar1.jpg" class="avatar" alt="Cliente satisfecho">
                        <div class="des">
                            <h5 class="ti-quote-left font-weight-bold"></h5>
                            <p><%= t('index.testimonials.item1.quote') %></p>
                            <div class="line"></div>
                            <h6 class="name"><%= t('index.testimonials.item1.name') %></h6>
                            <h6 class="xs-font"><%= t('index.testimonials.item1.position') %></h6>
                        </div>
                    </div>
                </div>
                <div class="item">
                    <div class="textmonial-item">
                        <img src="assets/imgs/avatar2.jpg" class="avatar" alt="CEO empresa">
                        <div class="des">
                            <h5 class="ti-quote-left font-weight-bold"></h5>
                            <p><%= t('index.testimonials.item2.quote') %></p>
                            <div class="line"></div>
                            <h6 class="name"><%= t('index.testimonials.item2.name') %></h6>
                            <h6 class="xs-font"><%= t('index.testimonials.item2.position') %></h6>
                        </div>
                    </div>
                </div>
                <div class="item">
                    <div class="textmonial-item">
                        <img src="assets/imgs/avatar3.jpg" class="avatar" alt="Emprendedora">
                        <div class="des">
                            <h5 class="ti-quote-left font-weight-bold"></h5>
                            <p><%= t('index.testimonials.item3.quote') %></p>
                            <div class="line"></div>
                            <h6 class="name"><%= t('index.testimonials.item3.name') %></h6>
                            <h6 class="xs-font"><%= t('index.testimonials.item3.position') %></h6>
                        </div>
                    </div>
                </div>
            </div>
        </div>
