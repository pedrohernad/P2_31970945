                    <div class="widget">
                        <div class="icon-wrapper"><i class="ti-palette"></i></div>
                        <div class="infos-wrapper">
                            <h4 class="text-primary">250+</h4>
                            <p><%= t('index.about.stats1') %></p>
                        </div>
                    </div>
                    <div class="widget">
                        <div class="icon-wrapper"><i class="ti-book"></i></div>
                        <div class="infos-wrapper">
                            <h4 class="text-primary">120+</h4>
                            <p><%= t('index.about.stats2') %></p>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-md-4">
                    <div class="widget">
                        <div class="icon-wrapper"><i class="ti-stats-up"></i></div>
                        <div class="infos-wrapper">
                            <h4 class="text-primary">98%</h4>
                            <p><%= t('index.about.stats3') %></p>
                        </div>
                    </div>
                    <div class="widget">
                        <div class="icon-wrapper"><i class="ti-medall"></i></div>
                        <div class="infos-wrapper">
                            <h4 class="text-primary">15+</h4>
                            <p><%= t('index.about.stats4') %></p>
                        </div>
                    </div>
                </div>
             </div>
        </div>
