    <!-- Sección de Contacto Inferior -->
    <section class="section bg-overlay">
        <div class="container">
            <div class="infos mb-4 mb-md-2">
            <div class="title">
                <h5><%= t('index.contact.title') %></h5>
                <p class="font-small"><%= t('index.contact.description') %></p>
            </div>
            <div class="socials">
                <div class="row justify-content-between">
                    <div class="col">
                        <a class="d-block subtitle"><i class="ti-microphone"></i> <%= t('index.contact.phone') %></a>
                        <a class="d-block subtitle"><i class="ti-email"></i> <%= t('index.contact.email') %></a>
                    </div>
                    <div class="col">
                        <h6 class="subtitle font-weight-normal mb-1"><%= t('index.social.title') %></h6>
                        <div class="social-links">
                            <a  href="#" class="link pr-1"><i class="ti-behance"></i></a>
                            <a  href="#" class="link pr-1"><i class="ti-dribbble"></i></a>
                            <a  href="https://www.instagram.com/accounts/login/?source=logged_out_sem" class="link pr-1"><i class="ti-instagram"></i></a>
                            <a  href="https://www.facebook.com/?locale2=es_ES&_rdr" class="link pr-1"><i class="ti-facebook"></i></a>
                        </div>
                    </div>
                </div>
            </div>
        </div> 
        </div>
    </section>

    <!-- Blog -->
    <section class="section" id="blog">
        <div class="container mb-3">
            <h6 class="xs-font mb-0"><%= t('index.blog.subtitle') %></h6>
            <h3 class="section-title mb-5"><%= t('index.blog.title') %></h3>

            <div class="blog-wrapper">
                <div class="img-wrapper">
                    <img src="assets/imgs/img-3.jpg" alt="Tendencias diseño gráfico">
                    <div class="date-container">
                        <h6 class="day">15</h6>
                        <h6 class="mun"><%= t('index.blog.month') %></h6> 
                    </div>
                </div>
                <div class="txt-wrapper">
                    <h4 class="blog-title"><%= t('index.blog.post.title') %></h4>
                    <p><%= t('index.blog.post.description') %></p>
                    <a  href="#" class="badge badge-info"><%= t('index.blog.post.tag') %></a>
                    <h6 class="blog-footer">
                        <a  href="javascript:void(0)"><i class="ti-user"></i> <%= t('index.blog.post.author') %></a> |
                        <a  href="javascript:void(0)"><i class="ti-thumb-up"></i> 158</a> |
                        <a  href="javascript:void(0)"><i class="ti-comments"></i> 45</a>
                    </h6>
                </div>
            </div>
        </div>
    </section>

    <!-- Formulario de Contacto -->
    <section id="contact" class="section pb-0">
        <div class="container">
            <h6 class="xs-font mb-0"><%= t('index.contactForm.subtitle') %></h6>
            <h3 class="section-title mb-5"><%= t('index.contactForm.title') %></h3>

            <div class="row align-items-center justify-content-between">
                <div class="col-md-8 col-lg-7">
                    <form id="formulario" class="contact-form">
                        <div class="form-row">
                            <div class="col form-group">
                                <input type="text" id="nombre" class="form-control" placeholder="<%= t('index.contactForm.name') %>">
                            </div>
                            <div class="col form-group">
                                <input type="email" id="email" class="form-control" placeholder="<%= t('index.contactForm.email') %>">
                            </div>
                        </div>
                        <div class="form-group">
                            <textarea cols="30" id="comentario" rows="5" class="form-control" placeholder="<%= t('index.contactForm.message') %>"></textarea>
                        </div>
                        <div class="form-group">
                                <div class="g-recaptcha" data-sitekey="<%= sitioKey %>"></div>
                        </div>
                        <div class="form-group">
                            <input type="submit" class="btn btn-primary btn-block" value="<%= t('index.contactForm.button') %>">
                        </div>
                    </form>
                </div>
                <div class="col-md-4 d-none d-md-block order-1">
                    <ul class="list">
                        <li class="list-head">
                            <h6><%= t('index.contactForm.infoTitle') %></h6>
                        </li>
                        <li class="list-body">
                            <p class="py-2"><%= t('index.contactForm.infoDesc') %></p>
                            <p class="py-2"><i class="ti-location-pin"></i> <%= t('index.contactForm.location') %></p>
                            <p class="py-2"><i class="ti-email"></i> <%= t('index.contact.email') %></p>
                            <p class="py-2"><i class="ti-microphone"></i> <%= t('index.contact.phone') %></p>
                        </li>
                    </ul> 
                </div>
            </div>

            <footer class="footer mt-5 border-top">
                <div class="row align-items-center justify-content-center">
                    <div class="col-md-6 text-center text-md-left">
                        <p class="mb-0"><%= t('index.footer.copyright') %></p>
                    </div>
                    <div class="col-md-6 text-center text-md-right">
                        <div class="social-links">
                            <a  href="#" class="link"><i class="ti-behance"></i></a>
                            <a  href="#" class="link"><i class="ti-dribbble"></i></a>
                            <a  href="https://www.instagram.com/accounts/login/?source=logged_out_sem" class="link"><i class="ti-instagram"></i></a>
                            <a  href="https://www.facebook.com/?locale2=es_ES&_rdr" class="link"><i class="ti-facebook"></i></a>
                        </div>
                    </div>
                </div> 
            </footer>
        </div>
    </section>

    <!-- Scripts (Mantenidos sin cambios) -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src='/js/animacion.js'></script>
    <script src='/js/fetch.js'></script>
    <script src="/js/desplegable.js"></script>
    <script src="assets/vendors/jquery/jquery-3.4.1.js"></script>
    <script src="assets/vendors/bootstrap/bootstrap.bundle.js"></script>
    <script src="assets/vendors/bootstrap/bootstrap.affix.js"></script>
    <script src="assets/vendors/owl-carousel/js/owl.carousel.js"></script>
    <script src="assets/js/Ollie.js"></script>
</body>
</html>