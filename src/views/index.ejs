                            <p class="mb-3"><%= t('index.benefits.item2.desc') %></p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4">
                    <div class="widget">
                        <div class="icon-wrapper"><i class="ti-medall"></i></div>
                        <div class="infos-wrapper">
                            <h4 class="text-primary"><%= t('index.benefits.item3.title') %></h4>
                            <p class="mb-3"><%= t('index.benefits.item3.desc') %></p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4">
                    <div class="widget">
                        <div class="icon-wrapper"><i class="ti-palette"></i></div>
                        <div class="infos-wrapper">
                            <h4 class="text-primary"><%= t('index.benefits.item4.title') %></h4>
                            <p class="mb-3"><%= t('index.benefits.item4.desc') %></p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4">
                    <div class="widget">
                        <div class="icon-wrapper"><i class="ti-money"></i></div>
                        <div class="infos-wrapper">
                            <h4 class="text-primary"><%= t('index.benefits.item5.title') %></h4>
                            <p class="mb-3"><%= t('index.benefits.item5.desc') %></p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4">
                    <div class="widget">
                        <div class="icon-wrapper"><i class="ti-support"></i></div>
                        <div class="infos-wrapper">
                            <h4 class="text-primary"><%= t('index.benefits.item6.title') %></h4>
                            <p class="mb-3"><%= t('index.benefits.item6.desc') %></p>
                        </div>
                    </div>
